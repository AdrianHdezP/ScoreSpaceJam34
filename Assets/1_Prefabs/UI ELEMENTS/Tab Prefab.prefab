    m_Modifications:
    - target: {fileID: 492659855483037492, guid: 4d7a6c97c18d8e84c95ddfe0d21634db, type: 3}
      propertyPath: textsEnglish
      value: TRY TO DELIVER AS MANY POTIONS AS POSIBLE<BR> DEFEAT ENEMIES BY HITTING
        THEM WITH YOUR CAUNDROL TO WIN POINTS<BR><BR> USE THE BRAKE BUTTON TO DRIFT
        AND SPILL POTIONS ON THE GROUND  THERE ARE THREE POTIONS WITH THREE DIFERENT
        EFFECTS.  <BR><BR>IF THE LEADERBOARD MALFUNCTIONS YOUR SCORE WILL BE STORED
        LOCALLY AND YOU CAN UPLOAD IT WHEN THE LEADERBOARD IS BACK UP AND RUNNING 
        <BR><BR>ANY FEEDBACK IS APPRECIATED! <BR>THANKS FOR PLAYING!
      objectReference: {fileID: 0}
    - target: {fileID: 492659855483037492, guid: 4d7a6c97c18d8e84c95ddfe0d21634db, type: 3}
      propertyPath: textsSpanish
      value: "INTENTA REPARTIR LA MAYOR CANTIDAD DE POCIONES POSIBLES. <BR>DERROTA
        ENEMIGOS AL GOLPEARLOS CON TU CALDERO PARA GANAR PUNTOS<BR> USA EL BOTTON
        DE BRAKE PARA DERRAPAR Y ESPARCIR LAS POCIONES POR EL SUELO<BR><BR> HAY TRES
        POCIONES CON TRES EFECTOS DIFERENTES<BR><BR>SI LA LEADERBOARD NO FUNCIONA
        TU PUNTUACI\xD3N TE GUARDARA LOCALMENTE Y PODRAS SUBIRLA CUANDO LA VUELVA
        A ESTAR FUNCIONANDO<BR><BR> CUALQUIER FEEDBACK SE AGRADECE!<BR>MUCHAS GRACIAS
        POR JUGAR!"
      objectReference: {fileID: 0}
